#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <DHT.h>
#include <ESP8266WiFi.h>

// WiFi
const char* ssid = "1234567890";
const char* password = "1234567890";

// ThingSpeak
const char* server = "api.thingspeak.com";
String apiKey = "ZR85B0FMUQBPSGQ7";

// OLED
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64

// DHT22
#define DHTPIN D4
#define DHTTYPE DHT22

// LEDs
#define RED_LED D5
#define GREEN_LED D6

// Relay
#define RELAY D7

// Soil
#define SOIL_PIN A0
#define DRY_VALUE  890
#define WET_VALUE  520

DHT dht(DHTPIN, DHTTYPE);
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

WiFiClient client;

float smoothSoil = 0;

void setup() {
  Serial.begin(115200);

  // Relay safety OFF
  pinMode(RELAY, OUTPUT);
  digitalWrite(RELAY, HIGH);

  pinMode(RED_LED, OUTPUT);
  pinMode(GREEN_LED, OUTPUT);

  Wire.begin(D2, D1);
  dht.begin();

  // OLED init
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    while (1);
  }

  display.clearDisplay();
  display.setTextColor(WHITE);

  // WiFi connect
  WiFi.begin(ssid, password);
  display.setCursor(0, 0);
  display.println("Connecting WiFi...");
  display.display();

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
  }

  display.clearDisplay();
  display.println("WiFi Connected!");
  display.display();
  delay(2000);
}

void loop() {

  float temp = dht.readTemperature();
  float hum = dht.readHumidity();
  int soilRaw = analogRead(SOIL_PIN);

  float soilPercent = ((float)(DRY_VALUE - soilRaw) / (DRY_VALUE - WET_VALUE)) * 100.0;
  soilPercent = constrain(soilPercent, 0, 100);

  // smoothing
  smoothSoil = (0.7 * smoothSoil) + (0.3 * soilPercent);

  display.clearDisplay();

  // Fail-safe
  if (isnan(temp) || isnan(hum)) {
    digitalWrite(RELAY, HIGH);
    display.setCursor(0, 20);
    display.println("Sensor Error!");
    display.display();
    delay(2000);
    return;
  }

  // LED logic
  if (temp > 30) {
    digitalWrite(RED_LED, HIGH);
    digitalWrite(GREEN_LED, LOW);
  } else {
    digitalWrite(RED_LED, LOW);
    digitalWrite(GREEN_LED, HIGH);
  }

  // Pump logic
  if (smoothSoil < 30) {
    digitalWrite(RELAY, LOW);   // ON
  } else {
    digitalWrite(RELAY, HIGH);  // OFF
  }

  // OLED display
  display.setTextSize(1);

  display.setCursor(0, 0);
  display.print("Temp: ");
  display.print(temp);
  display.println(" C");

  display.setCursor(0, 12);
  display.print("Hum: ");
  display.print(hum);
  display.println(" %");

  display.setCursor(0, 26);
  display.print("Soil: ");
  display.print(smoothSoil, 1);
  display.println(" %");

  display.setCursor(0, 40);
  display.print("Pump: ");
  if (smoothSoil < 30) display.println("ON");
  else display.println("OFF");

  display.display();

  // 🌐 Send data to ThingSpeak
  if (client.connect(server, 80)) {

    String url = "/update?api_key=" + apiKey;
    url += "&field1=" + String(temp);
    url += "&field2=" + String(hum);
    url += "&field3=" + String(smoothSoil);

    client.print(String("GET ") + url + " HTTP/1.1\r\n" +
                 "Host: " + server + "\r\n" +
                 "Connection: close\r\n\r\n");

    Serial.println("Data sent to ThingSpeak");
  }

  client.stop();

  delay(15000); // MUST
}
